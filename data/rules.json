  "pattern_rules": {
    "safe_with_any": ["solid"],
    "pairs_with_solid_only": [
      "striped", "vertical striped", "horizontal striped",
      "checked", "plaid", "tartan", "gingham",
      "floral", "paisley", "polka dot",
      "camouflage", "animal print", "abstract print",
      "graphic print", "tie dye", "geometric"
    ],
    "max_patterns_in_outfit": 2,
    "note": "If one garment has a bold pattern, all others should be solid"
  },

  "season_material_rules": {
    "summer":       ["cotton", "organic cotton", "linen", "rayon", "viscose", "jersey knit", "satin"],
    "winter":       ["wool", "cashmere", "fleece", "velvet", "corduroy", "leather", "suede"],
