    "texture_combination_rules": [
      "Matte + matte: safe — both fabrics share visual weight",
      "Matte + subtle sheen: excellent — adds depth without conflict",
      "High sheen + high sheen: avoid — silk + satin creates visual noise",
      "Rough + smooth: good — tweed jacket + smooth trousers is classic",
      "Coarse + fine: inner to outer — finer layers go closer to the body",
      "Technical + traditional: avoid mixing technical fabrics with luxury natural fabrics"
    ]
  },

  "garment_category_balance_rules": {
    "required_categories_per_outfit": ["top", "bottom", "footwear"],
    "optional_categories": ["outerwear", "accessory"],
    "valid_outfit_structures": [
      { "structure": "top + bottom + footwear",                    "score": 100, "label": "standard"          },
      { "structure": "top + outerwear + bottom + footwear",        "score": 100, "label": "layered"            },
      { "structure": "full_outfit + footwear",                     "score": 100, "label": "full_piece"         },
      { "structure": "top + bottom + footwear + accessory",        "score": 100, "label": "accessorised"       },
      { "structure": "top + bottom",                               "score":  60, "label": "missing_footwear"   },
      { "structure": "top + footwear",                             "score":  40, "label": "missing_bottom"     },
      { "structure": "bottom + footwear",                          "score":  40, "label": "missing_top"        },
      { "structure": "outerwear_only + footwear",                  "score":  50, "label": "incomplete_layering"}
    ],
    "category_conflict_rules": [
      "Do not include two bottoms in a scored outfit",
      "Do not include two full_outfit items",
      "Full_outfit items (dress, saree, sherwani) cancel all separate tops and bottoms",
      "Maximum one outerwear layer per outfit in scoring",
      "Maximum two footwear items disqualifies an outfit"
    ],
    "balance_score_formula": "sum(category_presence_scores) / required_category_count * 100"
  },

  "feature_vector_schema": {
    "description": "Defines the exact feature vector fed to XGBoost for outfit scoring. All values are numeric 0-100 except confidence_score (0-1).",
    "version": "1.0.0",
    "features": [
      { "name": "color_compatibility_score",   "type": "float", "range": [0, 100], "weight": 0.30, "source": "color_rules.good_pairs / bad_pairs"             },
      { "name": "fabric_compatibility_score",  "type": "float", "range": [0, 100], "weight": 0.15, "source": "fabric_compatibility_rules.good_fabric_pairs"    },
      { "name": "style_occasion_match_score",  "type": "float", "range": [0, 100], "weight": 0.20, "source": "style_occasion_rules"                            },
      { "name": "footwear_match_score",        "type": "float", "range": [0, 100], "weight": 0.15, "source": "footwear_style_rules + footwear_occasion_rules"   },
      { "name": "pattern_compatibility_score", "type": "float", "range": [0, 100], "weight": 0.08, "source": "pattern_rules"                                   },
      { "name": "fit_combination_score",       "type": "float", "range": [0, 100], "weight": 0.07, "source": "fit_combination_rules"                           },
      { "name": "garment_category_balance",    "type": "float", "range": [0, 100], "weight": 0.05, "source": "garment_category_balance_rules"                  }
    ],
    "output": {
      "compatibility_score": { "type": "int",   "range": [0, 100], "description": "Weighted sum of all feature scores, rounded to integer" },
      "confidence_score":    { "type": "float", "range": [0, 1],   "description": "Model confidence — based on training data density near this feature vector" }
    },
    "scoring_math": "compatibility_score = round( sum(feature_value[i] * weight[i]) for i in features )",
    "invalid_score_condition": "If any required feature (color, fabric, style_occasion, footwear, garment_balance) = null → return score=-1, confidence=0"
  },

  "occasion_canonical_labels": {
    "description": "Canonical occasion keys used throughout the system. UI selector, style_occasion_rules, and footwear_occasion_rules must all use these exact labels.",
    "labels": [
