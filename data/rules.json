    "formality_fabric_map": {
      "formal":          ["wool", "cashmere", "silk", "flannel", "tweed"],
      "smart_casual":    ["cotton", "linen", "wool", "suede", "corduroy"],
      "casual":          ["cotton", "denim", "jersey knit", "fleece", "linen"],
