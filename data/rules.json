  "xgboost_training_examples": {
    "description": "Labeled outfit examples for XGBoost training. Each example has a feature vector and a ground_truth_score validated against the Rule Corpus.",
    "version": "1.0.0",
    "examples": [
      {
        "id": "TRAIN-001",
