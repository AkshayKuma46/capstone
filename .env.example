# Google Gemini API key (required for LLM Stylist, Vision Model, Knowledge Extractor)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./wardrobe.db

# Vector store backend: "chroma" (dev) or "qdrant" (prod)
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./chroma_db

# Corpus + model paths
RULE_CORPUS_DIR=./
MODELS_DIR=./models

# Embedding model: "local" (sentence-transformers offline) or "gemini"
EMBEDDING_BACKEND=local

# Redis (optional, for score caching in prod)
REDIS_URL=redis://localhost:6379

# App settings
APP_ENV=development
LOG_LEVEL=INFO
